# Copy this file to python-service/.env and fill in the same MongoDB URI
# your Node server uses (server/.env's MONGO_URI) — the analysis job reads
# and writes to that same database.
MONGO_URI=mongodb://127.0.0.1:27017/pharma_management

# Optional overrides — defaults shown. Keep LOW_STOCK_THRESHOLD in sync with
# server/utils/inventoryConstants.js if you change it.
LOW_STOCK_THRESHOLD=10
SALES_LOOKBACK_DAYS=30
FAST_SLOW_TOP_N=10

# Medicines expiring within this many days (or already expired) count as
# "urgent" and drive the expiry-analysis dashboard notification badge.
EXPIRY_ALERT_DAYS=30

# Module 8 — Medicine Information API. This is the Django-based Python
# service that Node calls to fetch live Uses/Side Effects/Warnings/
# Storage/Dosage info.
MEDICINE_API_PORT=5001
MEDICINE_INFO_CACHE_TTL_HOURS=24

# Module 9 — AI Chatbot. This is served through the Django chatbot app,
# and Node calls it the same way it calls the medicine API above.
CHATBOT_API_PORT=5002
# Optional — leave blank to keep the "general question" fallback as a
# static message instead of an actual Gemini call.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
